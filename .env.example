# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.
# Never commit real values: this repo is public.

# AI chatbot fallback (optional)
GEMINI_API_KEY=

# ── Private contact details (server-only, never shipped to the browser) ──
# Where the contact form delivers, and shown on /for-recruiters.
CONTACT_EMAIL=
# Digits only, with country code, e.g. 6281234567890
CONTACT_WHATSAPP=

# ── Contact form ──
# https://resend.com → API Keys. Without a verified domain Resend can only send to your own
# account email, which is exactly what this form does.
RESEND_API_KEY=
# Optional. Needs a domain verified in Resend; defaults to onboarding@resend.dev.
CONTACT_FROM_EMAIL=
# https://dash.cloudflare.com → Turnstile → Add widget (free). Add your Vercel domain as hostname.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── /for-recruiters?key=... ──
# Comma-separated company:key:expiry entries. Key ≥ 12 chars; expiry (YYYY-MM-DD) is optional.
# Generate a key: node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
RECRUITER_KEYS=
# Full resume (with phone number). Share it as "Anyone with the link → Viewer".
RECRUITER_RESUME_URL=
# Optional: Drive folder with the unredacted certificates.
RECRUITER_DOCUMENTS_URL=
